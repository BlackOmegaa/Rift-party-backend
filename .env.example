PORT=3000
CORS_ORIGIN=http://localhost:4200

# BDD Postgres (Railway plugin en prod, instance separee recommandee en dev)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret de signature des JWT admin ET joueur (deux modules JWT distincts,
# meme secret) - generer une chaine aleatoire longue
JWT_SECRET=changeme

# Compte admin seede via `npx prisma db seed` (jamais commiter de vraies valeurs)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme

# Stripe (abonnement joueur 3E/mois) - cles de test d'abord (dashboard Stripe
# en mode Test), Price ID du produit recurrent, secret de signature du webhook
# (cree un endpoint Stripe vers <URL_BACKEND>/billing/webhook pour l'obtenir)
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_PRICE_ID=price_changeme

# URL du frontend pour les redirections Stripe Checkout/Portal apres paiement
# et les liens de reset de mot de passe (defaut : premiere origine de CORS_ORIGIN)
FRONTEND_URL=http://localhost:4200

# Postes de dev UNIQUEMENT (jamais en prod Railway) : le backend local ecrivant
# dans la meme BDD que la prod, tout visiteur vu par ce backend est marque
# Visitor.excluded (invisible dans les analytics de la console admin).
ANALYTICS_EXCLUDE_ALL=true

# Envoi d'emails transactionnels (reset de mot de passe) via resend.com.
# Sans cle (dev local), l'email est logge en console au lieu d'etre envoye.
# MAIL_FROM exige un domaine verifie dans Resend (SPF + DKIM).
RESEND_API_KEY=re_changeme
MAIL_FROM="Rift Party <support@riftparty.com>"
