// Schema Prisma - Rift Party
// Voir ROADMAP_DATABASE.md a la racine du repo pour le contexte produit.
// Architecture hybride : l'etat de jeu EN DIRECT reste en memoire (RoomsService
// et les services de mini-jeux) ; ce schema persiste seulement aux etapes cles
// (creation de room, fin de manche, connexions, votes tier list) pour survivre
// aux redemarrages et alimenter de vraies statistiques.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PLAYER
}

/// Compte utilisateur. Deux roles : ADMIN (popup metriques) et PLAYER (compte
/// joueur optionnel, sert uniquement a porter un abonnement a travers les
/// sessions - jamais requis pour jouer, l'anonId reste le mode par defaut).
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// Reinitialisation de mot de passe : hash SHA-256 du token envoye par
  /// email (jamais le token en clair - une fuite de BDD ne permet pas de
  /// reset). Un seul token actif a la fois, ecrase a chaque nouvelle demande.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  /// Verification d'email NON bloquante (on peut jouer et s'abonner sans) :
  /// email de bienvenue avec lien de confirmation a l'inscription, badge
  /// "email non verifie" + renvoi possible depuis la page Compte. Meme
  /// mecanique de token hashe que le reset de mot de passe.
  emailVerifiedAt      DateTime?
  verifyTokenHash      String?   @unique
  verifyTokenExpiresAt DateTime?

  subscriptions Subscription[]
}

/// Un abonnement Stripe (une ligne par cycle de vie d'abonnement Stripe, donc
/// l'historique est conserve). Le service prend toujours la plus recente par
/// userId pour determiner le statut actif. `status` reflete tel quel le champ
/// Stripe (active/trialing/past_due/canceled/...), pas d'enum pour rester
/// souple face aux valeurs Stripe qui peuvent evoluer.
model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
}

/// Une trace persistee par room creee (pas l'etat live, qui reste en memoire
/// dans RoomsService). Fermee quand le dernier joueur part.
model Room {
  id                String    @id @default(uuid())
  code              String    @unique
  createdAt         DateTime  @default(now())
  closedAt          DateTime?
  hostPseudoInitial String
  maxPlayersReached Int       @default(0)

  matches Match[]

  @@index([createdAt])
}

/// Une Party Mix complete, ou une partie solo hors mix.
model Match {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  playlist    String[]
  playerCount Int
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  rounds Round[]

  @@index([roomId])
}

/// Une manche/segment individuel, generique a tous les mini-jeux (miroir du
/// RoundResult in-memory de RoomsService).
model Round {
  id          String   @id @default(uuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id])
  gameId      String
  roundNumber Int
  scores      Json
  summary     String
  details     Json?
  finishedAt  DateTime @default(now())

  @@index([matchId])
  @@index([gameId])
}

/// Un placement de tier list soumis par un joueur (tiktok-ranking). Persiste
/// a la resolution du tribunal (fraudPenalty deja connu a ce moment-la).
model TiktokVote {
  id           String   @id @default(uuid())
  roomCode     String
  matchId      String?
  question     String
  pseudo       String
  anonId       String?
  placement    Json
  fraudPenalty Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([question])
  @@index([roomCode])
}

/// Compteurs communautaires incrementaux : combien de fois un champion a ete
/// place a un slot donne pour une question donnee, tous lobbies confondus.
/// Alimente l'affichage "lobby vs communaute" sans agregation a la volee.
model TiktokGlobalStats {
  id       String @id @default(uuid())
  question String
  slot     Int
  champion String
  count    Int    @default(0)

  @@unique([question, slot, champion])
  @@index([question])
}

enum ConnectionEventType {
  CONNECT
  DISCONNECT
}

/// Connexions/deconnexions socket, identifiees par un anonId genere cote
/// client (localStorage) puisqu'il n'y a pas de comptes joueurs. Log brut
/// (une ligne par evenement) : source de verite pour les series temporelles
/// (visiteurs uniques par jour) et la retention par cohorte. Voir `Visitor`
/// pour l'etat resume (premiere/derniere visite, source d'acquisition).
model ConnectionEvent {
  id        String              @id @default(uuid())
  anonId    String
  socketId  String
  roomCode  String?
  type      ConnectionEventType
  createdAt DateTime            @default(now())

  @@index([anonId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([socketId])
}

/// Etat resume par anonId (une ligne par visiteur, upsert a chaque connexion) :
/// evite de recalculer "premiere fois vu" en scannant tout l'historique de
/// ConnectionEvent a chaque chargement du dashboard. `acquisitionSource` est
/// fige a la premiere visite (first-touch attribution) : jamais ecrase par
/// les visites suivantes, meme si l'utilisateur revient via un autre canal.
model Visitor {
  anonId            String   @id
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  visitCount        Int      @default(1)
  acquisitionSource String?
  /// Appareil de l'equipe (admin/dev) : marque a la connexion a la console
  /// admin, exclu de TOUTES les metriques du dashboard pour ne pas fausser
  /// les stats avec les tests internes.
  excluded          Boolean  @default(false)

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

/// Une arrivee dans une room (creation = host, ou JOIN = invite). Alimente le
/// taux de conversion visiteur -> room rejointe et la viralite (viaInvite).
model RoomJoin {
  id        String   @id @default(uuid())
  roomCode  String
  anonId    String
  isHost    Boolean  @default(false)
  viaInvite Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([roomCode])
  @@index([anonId])
  @@index([createdAt])
}

/// Un clic sur "Copier le lien d'invitation" (room.component.ts). Compare a
/// RoomJoin.viaInvite pour mesurer le taux invitation -> joueur arrive.
model InviteGenerated {
  id        String   @id @default(uuid())
  roomCode  String
  anonId    String
  createdAt DateTime @default(now())

  @@index([roomCode])
  @@index([createdAt])
}

enum FunnelKind {
  SUBSCRIPTION
  DONATION
}

enum FunnelStep {
  OFFER_VIEWED
  CTA_CLICKED
  CHECKOUT_STARTED
  CHECKOUT_CANCELLED
  COMPLETED
}

/// Un pas dans le funnel de monetisation (abonnement Supporter ou donation
/// Ko-fi). Les pas cote client (offre vue, clic CTA, retour annule) arrivent
/// par POST /track/funnel ; les pas fiables (checkout demarre, paiement
/// confirme) sont enregistres cote serveur (BillingService + webhook Stripe,
/// l'anonId transitant par les metadata de la session Checkout). La jointure
/// anonId -> Visitor.acquisitionSource donne l'attribution des conversions.
model FunnelEvent {
  id        String     @id @default(uuid())
  anonId    String?
  userId    String?
  kind      FunnelKind
  step      FunnelStep
  createdAt DateTime   @default(now())

  @@index([kind, step, createdAt])
  @@index([anonId])
}

enum BugReportStatus {
  OPEN
  DONE
}

/// Signalement de bug/probleme envoye par un joueur depuis le bouton dedie
/// (room). Contexte capture automatiquement cote client ; consulte et traite
/// depuis la console admin (onglet Signalements).
model BugReport {
  id        String          @id @default(uuid())
  message   String
  pseudo    String?
  roomCode  String?
  gameId    String?
  anonId    String?
  page      String?
  status    BugReportStatus @default(OPEN)
  createdAt DateTime        @default(now())

  @@index([status, createdAt])
}

enum GameSessionOutcome {
  COMPLETED
  ABANDONED
}

/// Un lancement de mini-jeu pour UN joueur (que ce soit un segment de Party Mix
/// ou une partie solo hors mix) : une ligne creee au demarrage, cloturee a la
/// fin de la manche (ou a la deconnexion). Remplace l'ancien SessionEvent
/// (3 lignes disjointes STARTED/COMPLETED/ABANDONED) par une seule ligne avec
/// debut+fin : permet de calculer une duree sans avoir a recorreler des
/// evenements separes.
model GameSession {
  id          String              @id @default(uuid())
  anonId      String
  roomCode    String
  gameId      String
  startedAt   DateTime            @default(now())
  endedAt     DateTime?
  durationSec Int?
  outcome     GameSessionOutcome?

  @@index([gameId])
  @@index([anonId])
  @@index([startedAt])
  @@index([roomCode])
}
