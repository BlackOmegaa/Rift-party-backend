PORT=3000
CORS_ORIGIN=http://localhost:4200

# BDD Postgres (Railway plugin en prod, instance separee recommandee en dev)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret de signature des JWT admin - generer une chaine aleatoire longue
JWT_SECRET=changeme

# Compte admin seede via `npx prisma db seed` (jamais commiter de vraies valeurs)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme
